{
  "entities": {
    "UserSyncProfile": {
      "title": "UserSyncProfile",
      "description": "Non-PII cloud sync & migration profile scoped strictly by Firebase UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "migrationVersion": { "type": "integer" },
        "migratedFromGuestAt": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "ownerUid", "migrationVersion", "createdAt", "updatedAt"]
    },
    "WorkspaceCloudMeta": {
      "title": "WorkspaceCloudMeta",
      "description": "Cloud workspace metadata. Never stores plain-text API keys or secrets.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "hasPassphrase": { "type": "boolean" },
        "saltB64": { "type": "string", "maxLength": 256 },
        "keyCheckCipherB64": { "type": "string", "maxLength": 512 },
        "keyCheckIvB64": { "type": "string", "maxLength": 256 },
        "encryptedSecretsCipherB64": { "type": "string", "maxLength": 16384 },
        "secretsIvB64": { "type": "string", "maxLength": 256 },
        "clientUpdatedAt": { "type": "number" },
        "syncVersion": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "name", "deviceId", "hasPassphrase", "clientUpdatedAt", "syncVersion", "createdAt", "updatedAt"]
    },
    "ProjectCloudRecord": {
      "title": "ProjectCloudRecord",
      "description": "Cloud cartoon project metadata & structured script/scenes map (no audio/video binary blobs).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "ext": { "type": "string", "maxLength": 16 },
        "hasAudioAsset": { "type": "boolean" },
        "hasVideoAsset": { "type": "boolean" },
        "thumbDataUrl": { "type": "string", "maxLength": 65536 },
        "projectData": { "type": "object" },
        "clientUpdatedAt": { "type": "number" },
        "syncVersion": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "workspaceId", "title", "ext", "hasAudioAsset", "hasVideoAsset", "projectData", "clientUpdatedAt", "syncVersion", "createdAt", "updatedAt"]
    },
    "VoicePresetCloud": {
      "title": "VoicePresetCloud",
      "description": "Saved TTS voice preset metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "providerId": { "type": "string", "maxLength": 64 },
        "voiceId": { "type": "string", "maxLength": 200 },
        "voiceName": { "type": "string", "maxLength": 200 },
        "presetData": { "type": "object" },
        "clientUpdatedAt": { "type": "number" },
        "syncVersion": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "workspaceId", "name", "providerId", "voiceId", "voiceName", "presetData", "clientUpdatedAt", "syncVersion", "createdAt", "updatedAt"]
    },
    "PronunciationDictCloud": {
      "title": "PronunciationDictCloud",
      "description": "Thai pronunciation custom dictionary entries per workspace.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "entries": { "type": "array" },
        "clientUpdatedAt": { "type": "number" },
        "syncVersion": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "workspaceId", "entries", "clientUpdatedAt", "syncVersion", "createdAt", "updatedAt"]
    },
    "SettingsCloud": {
      "title": "SettingsCloud",
      "description": "Studio non-secret settings for a workspace.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "settingsData": { "type": "object" },
        "clientUpdatedAt": { "type": "number" },
        "syncVersion": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "workspaceId", "settingsData", "clientUpdatedAt", "syncVersion", "createdAt", "updatedAt"]
    },
    "AssetManifestCloud": {
      "title": "AssetManifestCloud",
      "description": "Metadata pointer to binary audio or GLB assets stored in Firebase Storage (never raw binary in Firestore).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "type": "string", "enum": ["scene_audio", "master_audio", "glb_model"] },
        "storagePath": { "type": "string", "minLength": 1, "maxLength": 512 },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 128 },
        "byteLength": { "type": "integer" },
        "sceneId": { "type": "string", "maxLength": 128 },
        "durationSec": { "type": "number" },
        "metadata": { "type": "object" },
        "clientUpdatedAt": { "type": "number" },
        "syncVersion": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "workspaceId", "projectId", "kind", "storagePath", "mimeType", "byteLength", "clientUpdatedAt", "syncVersion", "createdAt", "updatedAt"]
    },
    "PlatformUser": {
      "title": "PlatformUser",
      "description": "Platform membership, onboarding defaults, and role record (role/tier mutations server/admin only).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 240 },
        "emailVerified": { "type": "boolean" },
        "displayName": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "enum": ["member", "super_admin"] },
        "tier": { "type": "string", "enum": ["free", "studio_pass"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "onboarding": { "type": "object" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "email", "emailVerified", "role", "tier", "status", "onboarding", "createdAt", "updatedAt"]
    },
    "CreditWalletDoc": {
      "title": "CreditWalletDoc",
      "description": "User credit wallet balance (read-only to owner, mutated strictly server-side).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "balance": { "type": "integer" },
        "reserved": { "type": "integer" },
        "monthlyAllowance": { "type": "integer" },
        "totalSpent": { "type": "integer" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "balance", "reserved", "monthlyAllowance", "totalSpent", "updatedAt"]
    },
    "CreditLedgerDoc": {
      "title": "CreditLedgerDoc",
      "description": "Append-only credit ledger transaction (server/admin only write).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "integer" },
        "balanceAfter": { "type": "integer" },
        "note": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "uid", "type", "amount", "balanceAfter", "createdAt"]
    },
    "ManualPaymentDoc": {
      "title": "ManualPaymentDoc",
      "description": "Manual PromptPay or Gateway payment submission (status transitions strictly server/super-admin).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "referenceCode": { "type": "string" },
        "planId": { "type": "string" },
        "amountThb": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "expired"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "uid", "referenceCode", "planId", "amountThb", "status", "createdAt"]
    },
    "AccessCodeDoc": {
      "title": "AccessCodeDoc",
      "description": "Single-use or capped promo/admin activation code.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "tier": { "type": "string" },
        "days": { "type": "integer" },
        "bonusCredits": { "type": "integer" },
        "active": { "type": "boolean" }
      },
      "required": ["code", "tier", "days", "bonusCredits", "active"]
    },
    "WorkflowGraphDoc": {
      "title": "WorkflowGraphDoc",
      "description": "Visual LEGO workflow graph saved by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "name": { "type": "string" },
        "nodes": { "type": "array" },
        "edges": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "ownerUid", "name", "nodes", "edges", "updatedAt"]
    },
    "CmsPageDoc": {
      "title": "CmsPageDoc",
      "description": "Admin LEGO Page Builder published/draft pages.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "blocks": { "type": "array" }
      },
      "required": ["id", "slug", "title", "status", "blocks"]
    },
    "RenderJobDoc": {
      "title": "RenderJobDoc",
      "description": "Background FFmpeg video render & QA job record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "projectId": { "type": "string" },
        "status": { "type": "string" },
        "resolution": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "uid", "projectId", "status", "resolution", "createdAt"]
    },
    "AuditLogDoc": {
      "title": "AuditLogDoc",
      "description": "Admin/security audit log record (super admin read only).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorUid": { "type": "string" },
        "action": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "actorUid", "action", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserSyncProfile" },
      "description": "User-owned cloud sync profile (UID-isolated, zero PII)"
    },
    "/users/{userId}/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/WorkspaceCloudMeta" },
      "description": "User-owned workspaces"
    },
    "/users/{userId}/workspaces/{workspaceId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/ProjectCloudRecord" },
      "description": "User-owned cartoon projects inside a workspace"
    },
    "/users/{userId}/workspaces/{workspaceId}/voice_presets/{presetId}": {
      "schema": { "$ref": "#/entities/VoicePresetCloud" },
      "description": "User-owned voice presets inside a workspace"
    },
    "/users/{userId}/workspaces/{workspaceId}/pronunciation_dict/{dictId}": {
      "schema": { "$ref": "#/entities/PronunciationDictCloud" },
      "description": "User-owned Thai pronunciation dictionaries inside a workspace"
    },
    "/users/{userId}/workspaces/{workspaceId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SettingsCloud" },
      "description": "User-owned studio settings inside a workspace"
    },
    "/users/{userId}/workspaces/{workspaceId}/assets/{assetId}": {
      "schema": { "$ref": "#/entities/AssetManifestCloud" },
      "description": "Manifest pointing to binary audio/GLB files stored in Firebase Storage"
    },
    "/platform_users/{userId}": {
      "schema": { "$ref": "#/entities/PlatformUser" },
      "description": "Platform membership, tier, and onboarding defaults"
    },
    "/wallets/{userId}": {
      "schema": { "$ref": "#/entities/CreditWalletDoc" },
      "description": "Atomic credit wallet (server-mutated)"
    },
    "/credit_ledger/{txId}": {
      "schema": { "$ref": "#/entities/CreditLedgerDoc" },
      "description": "Immutable credit transaction ledger"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/ManualPaymentDoc" },
      "description": "Manual PromptPay and gateway payment records"
    },
    "/access_codes/{code}": {
      "schema": { "$ref": "#/entities/AccessCodeDoc" },
      "description": "Admin-managed promo/activation codes"
    },
    "/workflows/{workflowId}": {
      "schema": { "$ref": "#/entities/WorkflowGraphDoc" },
      "description": "User-saved LEGO video workflows"
    },
    "/pages/{pageId}": {
      "schema": { "$ref": "#/entities/CmsPageDoc" },
      "description": "CMS pages built via Admin LEGO Page Builder"
    },
    "/render_jobs/{jobId}": {
      "schema": { "$ref": "#/entities/RenderJobDoc" },
      "description": "Background FFmpeg video render & QA jobs"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogDoc" },
      "description": "Security & admin audit logs"
    }
  }
}
