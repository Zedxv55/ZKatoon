# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Central API key for Studio Pass users (default AI Brain: nvidia/nemotron-3.5-super-vl:free & AI Voice: fish-audio/s2.1-pro-free:free)
OPENROUTER_API_KEY=""

# OPENAI_API_KEY / ANTHROPIC_API_KEY: Optional central provider keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ZKATOON_VAULT_SECRET: 32+ char secret for AES-256-GCM BYOK encryption at rest
ZKATOON_VAULT_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
